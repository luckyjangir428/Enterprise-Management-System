{
  "info": {
    "_postman_id": "pern-erp-api-collection",
    "name": "PERN ERP API",
    "description": "REST API collection for the PERN ERP Enquiry to Dispatch workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "quotationId",
      "value": "1"
    },
    {
      "key": "salesOrderId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Sales User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@example.com\",\n  \"password\": \"Sales@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get Customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"XYZ Industries Pvt. Ltd.\",\n  \"contactPerson\": \"Amit Sharma\",\n  \"email\": \"amit@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Jaipur, Rajasthan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        }
      ]
    },
    {
      "name": "Products & Inventory",
      "item": [
        {
          "name": "Get Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory",
              "host": ["{{baseUrl}}"],
              "path": ["inventory"]
            }
          }
        }
      ]
    },
    {
      "name": "Enquiries",
      "item": [
        {
          "name": "Get Enquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/enquiries",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries"]
            }
          }
        },
        {
          "name": "Get Enquiry By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/enquiries/1",
              "host": ["{{baseUrl}}"],
              "path": ["enquiries", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Quotations",
      "item": [
        {
          "name": "Get Quotations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotations",
              "host": ["{{baseUrl}}"],
              "path": ["quotations"]
            }
          }
        },
        {
          "name": "Change Quotation Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations/{{quotationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["quotations", "{{quotationId}}", "status"]
            }
          }
        },
        {
          "name": "Convert Accepted Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"SO-POSTMAN-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations/{{quotationId}}/convert",
              "host": ["{{baseUrl}}"],
              "path": ["quotations", "{{quotationId}}", "convert"]
            }
          }
        }
      ]
    },
    {
      "name": "Sales Orders",
      "item": [
        {
          "name": "Get Sales Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-orders",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders"]
            }
          }
        },
        {
          "name": "Get Sales Order By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{salesOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{salesOrderId}}"]
            }
          }
        },
        {
          "name": "Confirm Sales Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{salesOrderId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{salesOrderId}}", "confirm"]
            }
          }
        },
        {
          "name": "Dispatch Sales Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"RJ14AB1234\",\n  \"driverName\": \"Rahul Sharma\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{salesOrderId}}/dispatch",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{salesOrderId}}", "dispatch"]
            }
          }
        },
        {
          "name": "Cancel Sales Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/{{salesOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["sales-orders", "{{salesOrderId}}", "cancel"]
            }
          }
        }
      ]
    }
  ]
}